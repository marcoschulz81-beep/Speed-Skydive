COACH_VIEW_ENABLED=false

# Optional OpenAI KI-Coaching.
# Wichtig: Hierfuer wird ein OpenAI API-Key von https://platform.openai.com/api-keys benoetigt.
# Ein ChatGPT Pro Login allein ist kein API-Key.
AI_COACHING_ENABLED=false
AI_COACHING_MODEL=gpt-5.4-mini
AI_COACHING_TIMEOUT_S=12
AI_COACHING_MAX_REQUESTS_PER_DAY=500
AI_COACHING_INCLUDE_IDENTIFIERS=false
OPENAI_API_KEY=
